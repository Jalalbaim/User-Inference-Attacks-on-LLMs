# Stage 7b: user-level DP-SGD (plan section 4 row 7). Needs a GPU (Kaggle T4).
STAGE_TITLE="7b user-level DP-SGD: fine-tune with users as the privacy unit, score as Stage 2"
NEEDS_GPU=1
MAX_HOURS=11.5
EST_RUNTIME="about 20-30 min per model on a T4 (measured locally on an RTX 3070: 0.10-0.12 s per sampled user, 0.2 h of training per model; T4 ~1.5-2x slower) plus ~3 min evaluation and scoring; 3 seeds x 5 settings about 5-7 h (the smoke run prints a measured estimate per model)"
SEEDS="0 1 2"                    # same members as Stage 2's main run of these seeds (paired with the non-DP models)
ETA=0.05
S7_EPS="1 2 4 8 inf"             # target user-level epsilon; inf = clipping only (no noise). 7a: eps > ~3.5 cannot be refuted with 175 users
S7_DELTA=1e-5
S7_Q=0.5                         # per-step Poisson sampling probability of each member user
S7_STEPS=150                     # T; each user takes part in ~q*T = 75 steps
S7_CLIP=1.0                      # L2 clip of each user's gradient
S7_DOCS_PER_USER=8               # docs drawn from a sampled user per step (= Stage 2's batch size)
S7_LR=5e-5                       # Adam, linear decay to 0 (Stage 2's learning rate; not tuned, tuning would need privacy)
S7_MODEL=EleutherAI/gpt-neo-125m
S7_MAXLEN=128
S7_OPACUS=1.5.4                  # accountant only
S7_KEEP_WEIGHTS=0                # 1 = also save each final model (fp16, ~250 MB each); it then goes into the zip too
ZIP_WEIGHTS=1                    # zip every file that exists, weights included (none exist unless S7_KEEP_WEIGHTS=1)
S7_SMOKE=0                       # 1 = few users and steps; prints a measured runtime estimate per model
S7_TINY=0                        # 1 = random 2-layer model (local pipeline test only, never on Kaggle)
SCORE_TABLE="dp/scores.csv.gz"
