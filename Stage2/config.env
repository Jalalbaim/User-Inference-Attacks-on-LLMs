# Stage 2: core C3 (plan section 4, row 2; Steps D-F). Needs a GPU (Kaggle T4).
STAGE_TITLE="Core C3: T-hat vs S_cat vs aggregator vs blind baseline, 10 seeds, variance decomposition"
NEEDS_GPU=1
MAX_HOURS=11.5
EST_RUNTIME="per main seed ~1.1 h training (4 epochs, measured 15.6 min/epoch) + S_cat (smoke measures it); null ~0.7 h; S_cat reference once per session"
SEEDS="0 1 2 3 4"                 # main seeds trained and scored in this session (second session: SEEDS="5 6 7 8 9")
S2_NULL_SEEDS="0"                 # null models (FIT members only) in this session; empty = none
ETA=0.05
# training (Stage1/train_score.py; settings agreed with the user, 4 epochs from 2026-11-24)
S2_MODEL=EleutherAI/gpt-neo-125m
S2_EPOCHS=4
S2_BS=8
S2_LR=5e-5
S2_MAXLEN=128
# S_cat (Stage2/scat.py; user's choices 2026-11-24: R = 4 orders, sliding window over the 2048 context)
S2_CAT_DRAWS=4                    # subset draws per (user, m) for m < 32
S2_CAT_R=4
S2_WINDOW=2048
S2_SMOKE=0                        # 1 = few users and steps; prints measured estimates for training and S_cat
S2_TINY=0                         # 1 = random 2-layer model (local pipeline test only, never on Kaggle)
SCORE_TABLE="main/scores.csv.gz"
