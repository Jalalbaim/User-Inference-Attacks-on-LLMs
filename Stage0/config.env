# Stage 0: Gaussian testbed (plan section 4, row 0). CPU only.
STAGE_TITLE="Gaussian testbed: Claim 1, Prop. 6, Cor. 2 (+ ui_toy E1-E6)"
NEEDS_GPU=0
MAX_HOURS=3
EST_RUNTIME="~40-60 min on Kaggle CPU (ui_toy ~25 min + stage0_checks ~15-30 min); ~1 min with S0_QUICK=1"
# Seeds are fixed inside ui_toy.py / stage0_checks.py (one rng seed per experiment).
SEEDS="fixed-in-code"
ETA=0.05
# Stage-0 knobs
