S0_TOY="E1 E2a E2b E2c E3b E5 E6 illus"      # ui_toy.py experiments to run
S0_CHECKS="all"                              # stage0_checks.py: q1 q2 q3 figs summary | all
SCORE_TABLE=""                               # no per-document LLM scores in Stage 0
