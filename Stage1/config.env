# Stage 1: reproduce Kandpal et al. on Enron (plan section 4, row 1). Needs a GPU (Kaggle T4).
STAGE_TITLE="Reproduce Kandpal: GPT-Neo 125M on Enron, T-hat AUROC vs m, null-model control"
NEEDS_GPU=1
MAX_HOURS=11.5
EST_RUNTIME="smoke ~10 min; one seed ~1.5-2 h (10 epochs, T4); the smoke run prints a measured estimate"
SEEDS="0"
ETA=0.05
# Stage-1 knobs
S1_RUN=main                       # main | null (null: train on FIT members only, evaluate EVAL users)
S1_SMOKE=0                        # 1 = 6 users, 60 steps x 2 epochs; prints the measured full-run estimate
S1_MODEL=EleutherAI/gpt-neo-125m
S1_EPOCHS=10                      # all epochs are run; the best member-validation epoch is scored
S1_BS=8
S1_LR=5e-5
S1_MAXLEN=128
SCORE_TABLE="scores.csv.gz"       # per-document score table (plan Step C), checked by the footer
S1_TINY=0                         # 1 = random 2-layer model (local pipeline test only, never on Kaggle)
